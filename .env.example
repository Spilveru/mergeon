# Optional: only needed when pointing to a different GitHub app during development.
# The client_id is public and the OAuth device flow does not use a client_secret,
# so the application stores no secrets.
#
# By default Mergeon uses an OAuth App (client_id starting with Ov), which lists
# all repositories accessible to the user, including repos where they are a
# collaborator. With a GitHub App (prefix Iv) the listing is limited to its
# installations.
# MERGEON_GITHUB_CLIENT_ID=Ov23liHW92VyuIBmLnUQ
# MERGEON_GITHUB_APP_MODE=oauth        # oauth | github-app (inferred from client_id)
# MERGEON_GITHUB_APP_SLUG=app-git-service   # only for the install link in github-app mode

# Optional (compile-time / dev): HTTPS update feed URL and Ed25519 public key
# (32-byte base64) used to verify `latest*.yml.sig`.
# APP_UPDATE_FEED_URL=https://github.com/Spilveru/mergeon/releases/latest/download
# MERGEON_UPDATE_PUBLIC_KEY=
